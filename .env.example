NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# E2E 或无网络演示环境可强制社区进入本地演示模式
# NEXT_PUBLIC_COMMUNITY_DEMO=true

# 仅用于部署说明，不会自动暴露到前端
# COMMUNITY_ADMIN_EMAIL=admin@example.com

# AI provider 配置在 Supabase Edge Function secrets，不放在 NEXT_PUBLIC_*：
# DeepSeek 菜谱教练（只配置在 Supabase secrets）
# GUIDE_AI_BASE_URL=https://api.deepseek.com/v1
# GUIDE_AI_API_KEY=server-only-key
# GUIDE_AI_MODEL=deepseek-chat
